{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Estilo "linuxmobile": fondo actual enmarcado a la izquierda, valores sin etiquetas a la derecha
    "logo": {
        // Hueco vacío (22×10): ahí se mete Mochi con su animación (mochi.sh, desde fish_greeting)
        "type": "data-raw",
        "source": "                      \n                      \n                      \n                      \n                      \n                      \n                      \n                      \n                      \n                      ",
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "",
        "key": { "width": 0 }
    },
    "modules": [
        "break",
        {
            // Cabecera con letras separadas
            "type": "command",
            "key": " ",
            "text": "echo \"$USER|$(. /etc/os-release; echo $ID)\" | tr a-z A-Z | sed 's/./& /g; s/ $//'",
            "format": "{#1;31}{}"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "{#90}─────────────────────────"
        },
        {
            "type": "os",
            "key": " ",
            "format": "{name} {arch}"
        },
        {
            "type": "memory",
            "key": " ",
            "format": "{used} / {total}"
        },
        {
            "type": "packages",
            "key": " ",
            "format": "{pacman} (pacman)"
        },
        {
            "type": "shell",
            "key": " ",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": " ",
            "format": "{pretty-name}"
        },
        {
            "type": "custom",
            "key": " ",
            "format": "github.com/iker15"
        },
        {
            // Rayas de colores en vez de círculos
            "type": "custom",
            "key": " ",
            "format": "{#31}▬▬ {#32}▬▬ {#33}▬▬ {#34}▬▬ {#35}▬▬ {#36}▬▬ {#37}▬▬ {#90}▬▬"
        }
    ]
}
