<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1710575157271461-1</unique-id>
	<command>foot -D %f</command>
	<description>Open the current directory in foot</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>ark</icon>
	<name>Comprimir en zip</name>
	<submenu></submenu>
	<unique-id>1762380000000001-1</unique-id>
	<command>ark --batch --changetofirstpath --add --autofilename zip %F</command>
	<description>Crea un .zip con lo seleccionado</description>
	<range></range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>ark</icon>
	<name>Extraer aquí</name>
	<submenu></submenu>
	<unique-id>1762380000000002-1</unique-id>
	<command>ark --batch --autodestination --autosubfolder %F</command>
	<description>Descomprime en esta carpeta</description>
	<range></range>
	<patterns>*.zip;*.rar;*.7z;*.tar;*.tar.gz;*.tgz;*.tar.xz;*.tar.bz2;*.tar.zst;*.gz;*.xz;*.bz2</patterns>
	<other-files/>
</action>
</actions>
