#!/usr/bin/env python3
# Wrapper de `caelestia record` que pide un nombre al parar la grabación.
# Uso: caelestia-record [args de caelestia record]
import shutil
import subprocess
import sys
import time
from datetime import datetime

from caelestia.utils.notify import close_notification, notify
from caelestia.utils.paths import recording_notif_path, recording_path, recordings_dir

RECORDER = "gpu-screen-recorder"


def running() -> bool:
    return subprocess.run(["pidof", RECORDER], stdout=subprocess.DEVNULL).returncode == 0


def ask_name(default: str) -> str:
    try:
        p = subprocess.run(
            [
                "fuzzel", "--dmenu", "--prompt-only=Nombre  ", f"--placeholder={default}",
                # Pequeño, abajo a la derecha; los colores salen del fuzzel.ini que genera caelestia
                "--anchor=bottom-right", "--x-margin=34", "--y-margin=34",
                "--font=JetBrains Mono NF:size=11", "--width=34",
                "--horizontal-pad=16", "--vertical-pad=10", "--inner-pad=0",
                "--border-radius=17", "--border-width=2",
            ],
            input="", capture_output=True, text=True,
        )
        name = p.stdout.strip() if p.returncode == 0 else ""
    except FileNotFoundError:
        name = ""
    name = name.replace("/", "-").strip(". ")
    return name or default


def stop() -> None:
    subprocess.run(["pkill", "-f", RECORDER], stdout=subprocess.DEVNULL)
    while running():
        time.sleep(0.1)

    try:
        close_notification(recording_notif_path.read_text())
    except IOError:
        pass

    name = ask_name(f"recording_{datetime.now().strftime('%Y%m%d_%H-%M-%S')}")
    if name.lower().endswith(".mp4"):
        name = name[:-4]
    recordings_dir.mkdir(exist_ok=True, parents=True)
    new_path = recordings_dir / f"{name}.mp4"
    i = 1
    while new_path.exists():
        new_path = recordings_dir / f"{name} ({i}).mp4"
        i += 1
    shutil.move(recording_path, new_path)

    action = notify(
        "--action=watch=Watch",
        "--action=open=Open",
        "--action=delete=Delete",
        "Recording stopped",
        f"Recording saved in {new_path}",
    )
    if action == "watch":
        subprocess.Popen(["xdg-open", new_path], start_new_session=True)
    elif action == "open":
        p = subprocess.run([
            "dbus-send", "--session", "--dest=org.freedesktop.FileManager1", "--type=method_call",
            "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1.ShowItems",
            f"array:string:file://{new_path}", "string:",
        ])
        if p.returncode != 0:
            subprocess.Popen(["xdg-open", new_path.parent], start_new_session=True)
    elif action == "delete":
        new_path.unlink()


if __name__ == "__main__":
    args = sys.argv[1:]
    if running() and "-p" not in args and "--pause" not in args:
        stop()
    else:
        sys.exit(subprocess.run(["caelestia", "record", *args]).returncode)
