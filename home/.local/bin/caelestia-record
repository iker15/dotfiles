#!/usr/bin/env python3
# Wrapper de `caelestia record` que pide un nombre al parar la grabación y avisa al pausar.
# Uso: caelestia-record [args de caelestia record]   (-p: pausar / seguir)
import os
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime

from caelestia.utils.notify import close_notification, notify
from caelestia.utils.paths import recording_notif_path, recording_path, recordings_dir

RECORDER = "gpu-screen-recorder"
# (en pausa o no: gpu-screen-recorder no lo dice, así que lo apuntamos aquí)
PAUSED = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "caelestia-record-paused")


def pids() -> list[int]:
    p = subprocess.run(["pidof", RECORDER], capture_output=True, text=True)
    return [int(x) for x in p.stdout.split()]


def running() -> bool:
    return bool(pids())


# (por número de proceso: `pkill -f` también le daría a cualquier terminal cuyo comando
# contenga "gpu-screen-recorder")
def signal_recorder(sig: int) -> None:
    for pid in pids():
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass


def ask_name(default: str) -> str:
    try:
        p = subprocess.run(
            [
                "fuzzel", "--dmenu", "--prompt-only=Nombre  ", f"--placeholder={default}",
                # Pequeño, abajo a la derecha; los colores salen del fuzzel.ini que genera caelestia
                "--anchor=bottom-right", "--x-margin=34", "--y-margin=34",
                "--font=JetBrains Mono NF:size=11", "--width=34",
                "--horizontal-pad=16", "--vertical-pad=10", "--inner-pad=0",
                "--border-radius=17", "--border-width=2",
            ],
            input="", capture_output=True, text=True,
        )
        name = p.stdout.strip() if p.returncode == 0 else ""
    except FileNotFoundError:
        name = ""
    name = name.replace("/", "-").strip(". ")
    return name or default


def toast(title: str, body: str, icon: str) -> None:
    # (se sustituyen entre sí: pausa ↔ sigue)
    subprocess.run([
        "notify-send", "-a", "Grabación", "-i", icon, "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:caelestia-record-pause", title, body,
    ])


def pause() -> None:
    if not running():
        toast("No estás grabando", "Empieza con Ctrl + Alt + R", "media-record")
        return
    signal_recorder(signal.SIGUSR2)
    if os.path.exists(PAUSED):
        os.remove(PAUSED)
        toast("Grabación reanudada", "Sigue grabando", "media-record")
    else:
        open(PAUSED, "w").close()
        toast("Grabación en pausa", "Ctrl + Alt + P para seguir", "media-playback-pause")


def stop() -> None:
    if os.path.exists(PAUSED):
        os.remove(PAUSED)
    signal_recorder(signal.SIGINT)
    while running():
        time.sleep(0.1)

    try:
        close_notification(recording_notif_path.read_text())
    except IOError:
        pass

    name = ask_name(f"recording_{datetime.now().strftime('%Y%m%d_%H-%M-%S')}")
    if name.lower().endswith(".mp4"):
        name = name[:-4]
    recordings_dir.mkdir(exist_ok=True, parents=True)
    new_path = recordings_dir / f"{name}.mp4"
    i = 1
    while new_path.exists():
        new_path = recordings_dir / f"{name} ({i}).mp4"
        i += 1
    shutil.move(recording_path, new_path)

    action = notify(
        "--action=watch=Watch",
        "--action=open=Open",
        "--action=delete=Delete",
        "Recording stopped",
        f"Recording saved in {new_path}",
    )
    if action == "watch":
        subprocess.Popen(["xdg-open", new_path], start_new_session=True)
    elif action == "open":
        p = subprocess.run([
            "dbus-send", "--session", "--dest=org.freedesktop.FileManager1", "--type=method_call",
            "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1.ShowItems",
            f"array:string:file://{new_path}", "string:",
        ])
        if p.returncode != 0:
            subprocess.Popen(["xdg-open", new_path.parent], start_new_session=True)
    elif action == "delete":
        new_path.unlink()


if __name__ == "__main__":
    args = sys.argv[1:]
    if "-p" in args or "--pause" in args:
        pause()
    elif running():
        stop()
    else:
        if os.path.exists(PAUSED):
            os.remove(PAUSED)
        sys.exit(subprocess.run(["caelestia", "record", *args]).returncode)
